#!/bin/bash
# Run ONE model across all 3 cats. Each cat handled serially within this process.
# Args:
#   $1 = model (e.g. openai/gpt-oss-120b)
#   $2 = "ceiling" (optional) to also run off_grounded mode for this model
# Per-cat parquet is resume-safe via dedup on code.
set -euo pipefail

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 <model> [ceiling]" >&2
    exit 1
fi
model="$1"
ceiling="${2:-}"
slug=$(echo "$model" | tr '/.:' '___')

set -a; source .env; set +a

csv_for_cat() {
  case "$1" in
    pasta) echo "datasets/manual_label/pasta_gold_250.csv" ;;
    chocolate) echo "datasets/manual_label/chocolate_gold_239.csv" ;;
    cheeses) echo "datasets/manual_label/cheeses_gold_239.csv" ;;
    *) echo "Unknown cat $1" >&2; exit 2 ;;
  esac
}

mkdir -p datasets/processed/direct_llm_v2

for cat in pasta chocolate cheeses; do
  csv=$(csv_for_cat "$cat")
  out="datasets/processed/direct_llm_v2/${cat}_${slug}_partner.parquet"
  echo "[$(date +%H:%M:%S)] >>> [$cat][partner] $model"
  OMP_NUM_THREADS=1 .venv/bin/python -m src.eval.direct_llm_v2 \
    --gold-codes "$csv" --domain "$cat" --model "$model" \
    --context-mode partner_input \
    --out "$out" --max-cost-usd 12.0 \
    || echo "[$(date +%H:%M:%S)] !!! $cat/$model partner failed, continuing"
done

if [ "$ceiling" = "ceiling" ]; then
  for cat in pasta chocolate cheeses; do
    csv=$(csv_for_cat "$cat")
    out="datasets/processed/direct_llm_v2/${cat}_${slug}_off_grounded.parquet"
    echo "[$(date +%H:%M:%S)] >>> [$cat][off_grounded] $model"
    OMP_NUM_THREADS=1 .venv/bin/python -m src.eval.direct_llm_v2 \
      --gold-codes "$csv" --domain "$cat" --model "$model" \
      --context-mode off_grounded \
      --off-cache-dir datasets/manual_label/off_cache \
      --out "$out" --max-cost-usd 3.0 \
      || echo "[$(date +%H:%M:%S)] !!! $cat/$model ceiling failed, continuing"
  done
fi

echo "[$(date +%H:%M:%S)] === $model DONE ==="
