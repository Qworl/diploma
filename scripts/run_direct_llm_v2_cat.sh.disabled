#!/bin/bash
# Run all 5 partner-input models + 2 ceiling-check models for ONE category.
# Args: $1 = cat (pasta|chocolate|cheeses), $2 = path to gold CSV
set -euo pipefail

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <cat> <csv_path>" >&2
    exit 1
fi
cat="$1"
csv="$2"

# Load OPENROUTER_API_KEY from .env (preserve any existing exports)
set -a
source .env
set +a

MAIN_MODELS=(
  "openai/gpt-oss-120b"
  "openai/gpt-4o-mini"
  "google/gemini-2.5-flash"
  "anthropic/claude-sonnet-4.5"
  "meta-llama/llama-3.1-70b-instruct"
)
CEILING_MODELS=(
  "openai/gpt-4o-mini"
  "google/gemini-2.5-flash"
)
mkdir -p datasets/processed/direct_llm_v2

for model in "${MAIN_MODELS[@]}"; do
  slug=$(echo "$model" | tr '/.:' '___')
  out="datasets/processed/direct_llm_v2/${cat}_${slug}_partner.parquet"
  echo "[$(date +%H:%M:%S)] >>> [$cat][partner] $model"
  OMP_NUM_THREADS=1 .venv/bin/python -m src.eval.direct_llm_v2 \
    --gold-codes "$csv" --domain "$cat" --model "$model" \
    --context-mode partner_input \
    --out "$out" --max-cost-usd 12.0 || echo "[$(date +%H:%M:%S)] !!! $cat/$model partner failed, continuing"
done

for model in "${CEILING_MODELS[@]}"; do
  slug=$(echo "$model" | tr '/.:' '___')
  out="datasets/processed/direct_llm_v2/${cat}_${slug}_off_grounded.parquet"
  echo "[$(date +%H:%M:%S)] >>> [$cat][off_grounded] $model"
  OMP_NUM_THREADS=1 .venv/bin/python -m src.eval.direct_llm_v2 \
    --gold-codes "$csv" --domain "$cat" --model "$model" \
    --context-mode off_grounded \
    --off-cache-dir datasets/manual_label/off_cache \
    --out "$out" --max-cost-usd 3.0 || echo "[$(date +%H:%M:%S)] !!! $cat/$model ceiling failed, continuing"
done

echo "[$(date +%H:%M:%S)] === $cat DONE ==="
