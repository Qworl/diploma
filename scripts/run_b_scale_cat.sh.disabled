#!/bin/bash
# Args: $1 = cat (pasta|chocolate|cheeses)
# Full B-scale annotation pipeline for one category:
#   Step A: fetch OFF cache for 650 new codes (0.5s rate)
#   Step B: annotate with gpt-5.5 off_grounded mode
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <cat>" >&2
    exit 1
fi

cat="$1"
set -a; source .env; set +a
mkdir -p datasets/processed/gpt55_gold

csv="datasets/manual_label/${cat}_b_scale_650.csv"
codes_file="/tmp/${cat}_b_scale_codes.txt"

if [ ! -f "$csv" ]; then
    echo "[$(date +%H:%M:%S)] [$cat] ERROR: $csv not found" >&2
    exit 1
fi

# Extract codes (skip header)
tail -n +2 "$csv" > "$codes_file"

n_codes=$(wc -l < "$codes_file")
echo "[$(date +%H:%M:%S)] [$cat] fetching OFF for $n_codes codes"

# Step A: fetch OFF for these codes (0.5s rate limit)
OMP_NUM_THREADS=1 .venv/bin/python -m src.manual_label.off_fetcher \
  --codes-file "$codes_file" \
  --cache-dir datasets/manual_label/off_cache \
  --rate-limit-sec 0.5 \
  || echo "[$(date +%H:%M:%S)] [$cat] fetch had errors, continuing"

echo "[$(date +%H:%M:%S)] [$cat] OFF fetch done, starting gpt-5.5 annotation"

# Step B: annotate with gpt-5.5 off_grounded
OMP_NUM_THREADS=1 .venv/bin/python -m src.eval.direct_llm_v2 \
  --gold-codes "$csv" --domain "$cat" \
  --model openai/gpt-5.5 \
  --context-mode off_grounded --off-cache-dir datasets/manual_label/off_cache \
  --out "datasets/processed/gpt55_gold/${cat}_gpt55_gold.parquet" \
  --max-cost-usd 32.0

echo "[$(date +%H:%M:%S)] [$cat] DONE"
